# ==============================================================================
# XAI-GUARD CENTRAL ENVIRONMENT CONFIGURATION (ROOT)
# ==============================================================================
# This single file drives the entire monorepo: web, dashboard, admin, and API.
# Do not create .env files inside individual apps.
# Turborepo automatically injects these into all tasks.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM (Next.js Apps & API)
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT_WEB="3000"
PORT_DASHBOARD="3001"
PORT_ADMIN="3002"
PORT_API="8000"

# ------------------------------------------------------------------------------
# 2. NEXT.JS PUBLIC VARIABLES (Exposed to Browsers)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
NEXT_PUBLIC_API_URL="http://localhost:8000/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/v1/ws"

# ------------------------------------------------------------------------------
# 3. BACKEND (FastAPI - services/api)
# ------------------------------------------------------------------------------
# Database
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="xaiguard"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Redis (Cache, Celery Broker, WebSocket PubSub)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}/0"
CELERY_BROKER_URL="redis://${REDIS_HOST}:${REDIS_PORT}/1"
CELERY_RESULT_BACKEND="redis://${REDIS_HOST}:${REDIS_PORT}/2"

# Security & Authentication
JWT_SECRET_KEY="super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# ------------------------------------------------------------------------------
# 4. EXTERNAL INTEGRATIONS & ML
# ------------------------------------------------------------------------------
# Threat Intelligence
ABUSEIPDB_API_KEY=""
VIRUSTOTAL_API_KEY=""

# MLOps & Tracking
MLFLOW_TRACKING_URI="http://localhost:5000"

# OpenTelemetry / Observability
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# ------------------------------------------------------------------------------
# 5. SECRETS (Next.js server-side only)
# ------------------------------------------------------------------------------
AUTH_SECRET="generate-with-openssl-rand-base64-32"

