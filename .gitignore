# ==============================================================================
# 1. NODE.JS & TURBOREPO (FULL-STACK FRONTEND/BACKEND)
# ==============================================================================
# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Caches
.next/
out/
build/
dist/
.turbo/
.vercel/
.eslintcache
.stylelintcache
.prettiercache
tsbuildinfo
*.tsbuildinfo

# ==============================================================================
# 2. PYTHON (BACKEND & MACHINE LEARNING)
# ==============================================================================
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments (Global rule to catch all .venv folders)
**/.venv/
**/venv/
**/env/

# Python caching and packaging
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# ==============================================================================
# 3. MACHINE LEARNING DATA & MODELS (XAI-GUARD CUSTOM)
# ==============================================================================
# Ignore all large raw datasets (so GitHub doesn't crash)
ml/data/**/*.csv
ml/data/**/*.txt
ml/data/**/*.pcap
ml/data/**/*.pcap_ISCX.csv

# Ignore saved AI models
ml/models/**/*.pkl
ml/models/**/*.h5
ml/models/**/*.pt
*.model

# Ignore Jupyter Notebook checkpoints
**/.ipynb_checkpoints/
profile_default/
ipython_config.py

# Preserve the ml/data/ directory structure, but ignore all actual files inside
ml/data/*
!ml/data/raw/
!ml/data/processed/
!ml/data/README.md
!ml/data/.gitignore
!ml/data/**/.gitkeep

# ==============================================================================
# 4. ENVIRONMENT VARIABLES & SECRETS
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ==============================================================================
# 5. LOGS, TESTING & DATABASES
# ==============================================================================
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases
*.sqlite
*.sqlite3
db.sqlite3
*.db
.redis/

# Testing
coverage/
.nyc_output/
.tox/
.pytest_cache/
playwright-report/
test-results/

# ==============================================================================
# 6. OS & IDE SETTINGS
# ==============================================================================
# macOS / Windows
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs (VSCode, Cursor, IntelliJ)
.idea/
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
.cursorrules
.cursor/
.fleet/

# Runtime logs
install.log
*.log
*.npy
*.npy
*.pt
