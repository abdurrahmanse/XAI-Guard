# Ignore everything in this directory (so no data gets pushed to github)
*

# Except for these folder structures and readmes
!.gitignore
!README.md
!raw/
!processed/
!**/.gitkeep

# Never track large binary processed data files in Git.
# These are pipeline outputs — track them with DVC instead.
# Committing .npy / .pkl files causes index corruption and bloats git history.
processed/*.npy
processed/*.pkl
processed/*.csv
processed/*.json
