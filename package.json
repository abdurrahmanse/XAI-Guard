{
  "name": "xai-guard",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:dashboard": "turbo run build --filter=dashboard",
    "build:admin": "turbo run build --filter=admin",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:build": "turbo run clean",
    "kill:web": "kill-port 3000",
    "kill:dashboard": "kill-port 3001",
    "kill:admin": "kill-port 3002",
    "kill:api": "kill-port 8000",
    "kill:all": "kill-port 3000 3001 3002 8000",
    "ports": "npx kill-port --list 3000 3001 3002 8000"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "prettier": "^3.4.2",
    "turbo": "^2.10.12",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
